# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase
# (Supabase > Project Settings > API).

# Públicas (se pueden ver en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Privada: SOLO servidor (panel de gestión y pipeline de edición). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Buckets de Supabase Storage
SUPABASE_BUCKET_ORIGINALES=originales
SUPABASE_BUCKET_PROCESADAS=procesadas
